{
  "name": "eggd_contaminant_detector",
  "title": "eggd_contaminant_detector",
  "summary": "App to produce plots on contamination source",
  "dxapi": "1.0.0",
  "version": "0.1.0",
  "properties": {
    "githubRelease": "0.1.0"
    },
  "inputSpec": [
    {
      "name": "contaminated_samples",
      "class": "array:file",
      "optional": false,
      "label": "Contaminated samples",
      "help": "Array of VCFs from contaminated samples"
    },
    {
      "name": "candidates",
      "class": "array:file",
      "optional": false,
      "label": "Candidates",
      "help": "Array of VCFs that are candidates for being a contamination source"
    },
    {
      "name": "reference",
      "class": "file",
      "optional": false,
      "label": "Reference genome tarball",
      "help": "Tarball containing reference genome"
    }
  ],
  "outputSpec": [
    {
      "name": "sompy_csv",
      "class": "file",
      "label": "sompy CSV",
      "patterns": [
        "*.csv"
      ],
      "help": "Aggregated sompy output for all samples"
    },
    {
      "name": "recall_plot",
      "class": "file",
      "label": "Recall plot",
      "patterns": [
        "*.png", "*.html", "*.svg", "*.jpg", "*.jpeg"
      ]
    }
  ],
  "runSpec": {
    "assetDepends": [
      {
	"id": "record-J6Qj380475ZY7KkF605PF8kv"
      },
      {
	"id": "record-J6KfPzQ48PFXB5GF6BbYyFY1"
      }
    ],
    "timeoutPolicy": {
      "*": {
        "hours": 2
      }
    },
    "distribution": "Ubuntu",
    "release": "24.04",
    "version": "0",
    "interpreter": "python3",
    "file": "src/script.py"
  },
  "developers":[
    "org-emee_1"
  ],
  "authorizedUsers": [
    "org-emee_1"
  ],
  "regionalOptions": {
    "aws:eu-central-1": {
      "systemRequirements": {
        "main": {
          "instanceType": "mem1_ssd1_v2_x2"
        },
	"sompy": {
	  "instanceType": "mem1_ssd1_v2_x4"
	},
	"aggregate": {
	  "instanceType": "mem1_ssd1_v2_x2"
	}
      }
    }
  }
}
